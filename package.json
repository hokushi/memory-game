{
  "name": "memory-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "docker compose up -d && pnpm dev:front",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f backend",
    "dev:front": "pnpm --filter frontend dev",
    "build:front": "pnpm --filter frontend build",
    "lint:front": "pnpm --filter frontend lint",
    "dev:back": "pnpm --filter backend dev",
    "build:back": "pnpm --filter backend build",
    "start:back": "pnpm --filter backend start",
    "dev:ext": "pnpm --filter external-api dev",
    "build:ext": "pnpm --filter external-api build",
    "start:ext": "pnpm --filter external-api start"
  }
}
