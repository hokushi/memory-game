# Fastify サーバー
PORT=3002
HOST=0.0.0.0

# 実行環境。本番では production を指定する（ローカルは未設定でOK）
# NODE_ENV=production

# CORS 許可オリジン。本番(NODE_ENV=production)のときだけ効く。
# ローカルはすべて許可。本番はカンマ区切りで自分のフロントだけに絞る
# CORS_ORIGIN=https://memory-game.com

# JWT 署名用シークレット（本番は必ず推測されない値にする）
JWT_SECRET=dev-secret-change-me

# PostgreSQL（docker-compose の既定値に合わせている）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/memory_game
