# このファイルをコピーして backend/.env.local を作る（ホストで直接起動するとき用）:
#   cp .env.example .env.local
# docker で起動する場合は docker-compose.yml の environment: が使われるので不要。

# 実行環境（必須）。ローカルは local、本番は production
NODE_ENV=local

# Fastify サーバー
PORT=3002
HOST=0.0.0.0

# JWT 署名用シークレット（本番は必ず推測されない値にする）
JWT_SECRET=dev-secret-change-me

# PostgreSQL（docker-compose の既定値に合わせている）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/memory_game

# 写真アップロード先の S3（必須）
AWS_REGION=ap-northeast-1
S3_BUCKET=memory-game-photos-dev

# イベント送信先の別アプリ（external-api）。必須。
# ホストで直接起動するときは localhost、docker のときは compose が service 名を渡す。
EXTERNAL_API_URL=http://localhost:3003
# 利用登録でもらった ID（署名する JWT の iss に入る）
EXTERNAL_API_CLIENT_ID=cli_xxxxxxxxxxxxxxxx
# 署名用の秘密鍵。Ed25519 の PEM を base64 にしたものを入れる:
#   openssl genpkey -algorithm ed25519 -out private.pem
#   base64 -i private.pem | tr -d '\n'
# 公開鍵の方を external-api に登録する:
#   openssl pkey -in private.pem -pubout -out public.pem
#   pnpm --filter external-api register-client memory-game ./public.pem
EXTERNAL_API_PRIVATE_KEY=

# AWS 認証情報。ローカルは下記いずれかで渡す（本番 ECS はタスクロールが使われる）:
#   - このファイルに AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY を書く
#   - もしくは ~/.aws/credentials（aws configure）を使う
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
