# このファイルをコピーして external-api/.env.local を作る（ホストで直接起動するとき用）:
#   cp .env.example .env.local
# docker で起動する場合は docker-compose.yml の environment: が使われるので不要。

# 実行環境（必須）。ローカルは local、本番は production
NODE_ENV=local

# Fastify サーバー。memory-game 側（frontend:3000 / backend:3002）と被らせない
PORT=3003
HOST=0.0.0.0

# PostgreSQL。memory-game とは別の DB（docker-compose の external-db、ホストからは 5433）
DATABASE_URL=postgres://postgres:postgres@localhost:5433/external_api

# 呼び出し元の認証は clients テーブルの公開鍵で行うため、
# 共有の秘密（APIキー）は持たない。
# 利用登録は次で行う（公開鍵を clients に 1 行入れるだけ）:
#   pnpm --filter external-api register-client <名前> <公開鍵のPEM>

