# 開発用 Dockerfile（tsx watch でホットリロード）。
# 本番用ではない。ビルドコンテキストはリポジトリのルート（docker-compose.yml 参照）。
FROM node:22-slim

# pnpm を corepack で有効化（package.json の packageManager に追従）
RUN corepack enable

WORKDIR /app

# 依存解決に必要なマニフェストだけ先にコピーして install レイヤーをキャッシュさせる。
# pnpm はワークスペース全体の整合性を見るので、使わないパッケージの
# package.json も置いておく必要がある。
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY external-api/package.json ./external-api/package.json
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json

# external-api とその依存だけインストールする。
# pnpm 11 は未承認のビルドスクリプト検出で exit 1 になるが node_modules 自体は
# 展開済みなので、そのケースだけは無視して続行する。
RUN set -e; \
    status=0; \
    out="$(pnpm install --frozen-lockfile --filter external-api... 2>&1)" || status=$?; \
    printf '%s\n' "$out"; \
    if [ "$status" -ne 0 ] && ! printf '%s' "$out" | grep -q 'ERR_PNPM_IGNORED_BUILDS'; then \
      echo "pnpm install failed (exit $status)" >&2; \
      exit "$status"; \
    fi

# esbuild（tsx が使うネイティブバイナリ）を明示的にビルドする
RUN pnpm --filter external-api rebuild esbuild

# install が実際に成功したかを検証する
RUN test -x external-api/node_modules/.bin/drizzle-kit \
    && test -x external-api/node_modules/.bin/tsx \
    || { echo "node_modules is incomplete (drizzle-kit / tsx not found)" >&2; exit 1; }

# external-api のソースをコピー（src は compose でマウントするので上書きされる）
COPY external-api ./external-api

WORKDIR /app/external-api

EXPOSE 3003

# スキーマを反映してから dev サーバーを起動する。
CMD ["sh", "-c", "node_modules/.bin/drizzle-kit push && node_modules/.bin/tsx watch src/server.ts"]
